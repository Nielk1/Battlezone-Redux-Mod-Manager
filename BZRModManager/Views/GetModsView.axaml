<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:BZRModManager.Controls"
             xmlns:converters="using:BZRModManager.Converters"
             xmlns:models="using:BZRModManager.Models"
             xmlns:gb="using:GroupBox.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="850"
             x:Class="BZRModManager.Views.GetModsView">
  <UserControl.Styles>
    <Style>
      <Style.Resources>
        <StreamGeometry x:Key="icon_spinner">
          M268.078,512C126.693,511.962,12.108,397.316,12.146,255.932S126.83-0.038,268.215,0c96.559,0.026,184.888,54.38,228.428,140.565c7.695,15.91,1.035,35.046-14.875,42.74c-15.501,7.497-34.155,1.384-42.213-13.834C391.771,74.81,276.296,36.808,181.634,84.592S48.97,247.851,96.754,342.513s163.259,132.664,257.921,84.88c36.48-18.414,66.133-47.987,84.646-84.417c8.018-15.753,27.287-22.023,43.04-14.005c15.753,8.018,22.023,27.287,14.005,43.04l0,0C452.852,458.077,364.519,512.244,268.078,512z
        </StreamGeometry>
        <StreamGeometry x:Key="icon_earth">
          m12,0C5.383,0,0,5.383,0,12s5.383,12,12,12,12-5.383,12-12S18.617,0,12,0Zm3.534,13.511l-2.241,4.856c-.178.386-.564.633-.989.633h-.213c-.602,0-1.09-.488-1.09-1.09v-2.365c0-.349-.139-.684-.386-.931l-1.19-1.19c-.272-.272-.425-.641-.425-1.025v-.963c0-.279-.111-.547-.309-.745l-.373-.373c-.204-.204-.48-.318-.768-.318h-1.949c-.384,0-.751-.157-1.016-.436l-1.658-1.743c1.587-3.43,5.052-5.821,9.073-5.821.206,0,.407.019.609.031-.533.808-1.016,1.551-1.309,2.005-.185.285-.189.648-.014.94l.837,1.396c.222.369.163.842-.141,1.147l-.003.003c-.286.286-.722.357-1.084.176l-.88-.44c-.307-.154-.678-.093-.921.149l-.529.529c-.312.312-.312.817,0,1.128l.592.592c.22.22.519.344.83.344h1.431c.381,0,.754.107,1.077.309l2.562,1.601c.539.337.744,1.023.477,1.601Zm3.99-1.251c-.332-.165-.575-.467-.665-.827l-.627-2.507c-.137-.548.106-1.121.595-1.403l1.583-.913c1.002,1.557,1.59,3.405,1.59,5.39,0,.488-.047.963-.115,1.432l-2.362-1.172Z
        </StreamGeometry>
      </Style.Resources>
    </Style>
  </UserControl.Styles>
  <TabControl>
    <TabItem>
      <TabItem.Header>
        <Panel>
          <TextBlock Margin="0 0 25 0">From URL</TextBlock>
          <PathIcon Data="{StaticResource icon_earth}"
                    IsVisible="{Binding FromUrlIsBusy,
                                Converter={x:Static BoolConverters.Not}}"
                    HorizontalAlignment="Right"/>
          <PathIcon Data="{StaticResource icon_spinner}"
                    Classes="Rotator Throbber"
                    IsVisible="{Binding FromUrlIsBusy}"
                    HorizontalAlignment="Right"/>
        </Panel>
      </TabItem.Header>
      <StackPanel Orientation="Vertical">
        <TextBox Grid.ColumnSpan="2"
                 Grid.Row="0"
                 Grid.Column="0"
                 Height="30"
                 Margin="2.5 5 2.5 5"
                 Watermark="Workshop Published File ID or URL"
                 Text="{Binding Url}"/>
        <UniformGrid Columns="1">
          <Button HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Height="100"
                  Margin="2"
                  IsEnabled="{Binding EnableUrlTypeSteamCmd}"
                  Content="Download via SteamCmd"/>
          <Button HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Height="100"
                  Margin="2"
                  IsEnabled="{Binding EnableUrlTypeSteam}"
                  Content="Download via Steam"/>
          <Button HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Height="100"
                  Margin="2"
                  IsEnabled="{Binding EnableUrlTypeGit}"
                  Content="Download via Git"/>
        </UniformGrid>
      </StackPanel>
    </TabItem>
    <TabItem Header="Curated">
      <Panel>
        <TextBlock>Curated</TextBlock>
      </Panel>
    </TabItem>
    <TabItem Header="Workshop">
      <Panel>
        <TextBlock>Workshop</TextBlock>
      </Panel>
    </TabItem>
  </TabControl>
</UserControl>
