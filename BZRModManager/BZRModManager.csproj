<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BZRModManager</RootNamespace>
    <AssemblyName>BZRModManager</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ApplicationIcon>Resources\modmanager.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy .NET Framework AssemblyInfo conflicts with the SDK-generated one -->
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Content Remove="C:\Users\Nielk1\.nuget\packages\iniparser_net8\4.0.0\contentFiles\any\net8.0\iniParser_Net8.ico" />
    <None Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IniParser_Net8" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deps\SteamVent\SteamVent\SteamVent.csproj" />
    <ProjectReference Include="..\Deps\SteamVent\SteamVent.SteamCmd\SteamVent.SteamCmd.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="fixes\bzrmm_bzccjoinfix\addonAssets\bzshell_multi.cfg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="fixes\bzrmm_bzccjoinfix\bzrmm_bzccjoinfix.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\nielk1_eyes_128.png" />
    <Content Include="Resources\award_icon.png" />
    <Content Include="Resources\github_icon.png" />
    <None Include="Resources\modmanager.ico" />
    <None Include="Resources\discord_icon.png" />
  </ItemGroup>

  <!--
    Native runtime dependencies of SteamVent.SteamCmd (steamcmdprox.exe, steamcmdinj.dll)
    are produced by the Visual Studio C++ projects Deps\SteamVent\steamcmdinj and Deps\SteamVent\steamcmdprox.
    They cannot be built with the .NET CLI, so only copy them if they were already built and warn otherwise.
  -->
  <PropertyGroup>
    <SteamVentNativeDir>$(MSBuildThisFileDirectory)..\Deps\SteamVent\SteamVent.SteamCmd\bin\$(Configuration)\net10.0</SteamVentNativeDir>
  </PropertyGroup>

  <Target Name="CopySteamVentNativeRuntimeDeps" AfterTargets="PostBuildEvent" Condition="Exists('$(SteamVentNativeDir)\steamcmdprox.exe')">
    <Exec Command="copy /Y &quot;$(SteamVentNativeDir)\steamcmdinj.dll&quot; &quot;$(TargetDir)steamcmdinj.dll&quot;&#xD;&#xA;copy /Y &quot;$(SteamVentNativeDir)\steamcmdprox.exe&quot; &quot;$(TargetDir)\steamcmdprox.exe&quot;&#xD;&#xA;copy /Y &quot;$(SteamVentNativeDir)\steamcmdprox.pdb&quot; &quot;$(TargetDir)\steamcmdprox.pdb&quot;" />
  </Target>
  <Target Name="WarnMissingSteamVentNativeRuntimeDeps" AfterTargets="PostBuildEvent" Condition="!Exists('$(SteamVentNativeDir)\steamcmdprox.exe')">
    <Warning Text="SteamVent native runtime dependencies (steamcmdprox.exe, steamcmdinj.dll) were not found in '$(SteamVentNativeDir)'. Build the steamcmdinj/steamcmdprox C++ projects with Visual Studio to enable SteamCmd automation." />
  </Target>

</Project>