      </StreamGeometry>
      <converters:GameIdToBoolConverter x:Key="GameIdToBoolConverter" />
    </Style.Resources>

    <!-- Set Defaults -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border Margin="5"
                BorderThickness="1"
                BorderBrush="Gray"
                MinWidth="600"
                Height="130">
          <DockPanel LastChildFill="True">
            <Image Source="{Binding Image,
                            TargetNullValue={x:Static models:ModData.FallbackImage},
                            FallbackValue={x:Static models:ModData.FallbackImage}}"
                   Height="128"
                   Width="128"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   DockPanel.Dock="Left"/>
            <StackPanel Orientation="Vertical"
                        DockPanel.Dock="Right">
              <Button>test</Button>
              <Button>test</Button>
              <Button>test</Button>
              <Button>test</Button>
            </StackPanel>
            <DockPanel LastChildFill="True">
              <TextBlock Text="{Binding Title, FallbackValue=Mod Title}"
                         DockPanel.Dock="Top"
                         TextAlignment="Left"
                         FontWeight="Bold"
                         Padding="5 4 5 4"
                         TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal"
                          DockPanel.Dock="Bottom">
                <Border BorderThickness="1"
                        BorderBrush="Gray"
                        Padding="0"
                        Margin="4 0 0 4"
                        IsVisible="{Binding GameId,
                                    Converter={StaticResource GameIdToBoolConverter},
                                    ConverterParameter=Battlezone98Redux}">
                  <Image Source="/Assets/bz98r.ico"
                         Width="20"
                         Height="20"
                         RenderOptions.BitmapInterpolationMode="HighQuality"/>
                  <ToolTip.Tip>
                    Battlezone 98 Redux
                  </ToolTip.Tip>
                </Border>
                <Border BorderThickness="1"
                        BorderBrush="Gray"
                        Padding="0"
                        Margin="4 0 0 4"
                        IsVisible="{Binding GameId,
                                    Converter={StaticResource GameIdToBoolConverter},
                                    ConverterParameter=BattlezoneComatCommander}">
                  <Image Source="/Assets/bzcc.ico"
                         Width="20"
                         Height="20"
                         RenderOptions.BitmapInterpolationMode="HighQuality"/>
                  <ToolTip.Tip>
                    Battlezone Combat Commander
                  </ToolTip.Tip>
                </Border>
                <PathIcon Data="{StaticResource icon_cloud}"
                          Margin="4 0 0 4"
                          IsVisible="{Binding IonDriverData,
                                      Converter={x:Static ObjectConverters.IsNotNull}}">
                  <ToolTip.Tip>
                    Has Cloud Data
                  </ToolTip.Tip>
                </PathIcon>
                <PathIcon Data="{StaticResource icon_hasupdate}"
                          Margin="4 0 0 4"
                          IsVisible="{Binding HasUpdate}">
                  <ToolTip.Tip>
                    Has Update
                  </ToolTip.Tip>
                </PathIcon>
              </StackPanel>
              <TextBlock Text="{Binding Description, FallbackValue=Mod Description}"
                         TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis"
                         Padding="5 4 5 4"/>
            </DockPanel>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
